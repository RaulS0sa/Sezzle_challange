{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (Go)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/sezzle-calculator/server",
      "cwd": "${workspaceFolder}/sezzle-calculator/server",
      "env": {},
      "args": [],
      "console": "integratedTerminal"
    },
    {
      "name": "Frontend (React)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/sezzle-calculator/client",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack Calculator",
      "configurations": ["Backend (Go)", "Frontend (React)"],
      "stopAll": true
    }
  ]
}